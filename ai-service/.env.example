# ── Groq (PRIMARY — ~800 tokens/sec, 14 400 req/day free) ────────────────────
# Register at https://console.groq.com → API Keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Ollama (local, no API key needed) ────────────────────────────────────────
# Install: https://ollama.ai — then: ollama pull phi4-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ENABLED=false  # Set to "true" ONLY if Ollama is running locally

# ── Service ───────────────────────────────────────────────────────────────────
AI_SERVICE_PORT=8000
